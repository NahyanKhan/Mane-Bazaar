# Copy to .env. Never commit real values.
PORT=4180
# Inbound Meta webhook setup. No public hosting is included in this local pilot.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Seller number in international digits-only format, registered by the operator.
WHATSAPP_SELLER_NUMBER=
# Explicit opt-in to outbound messaging. Off by default.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a currently supported Graph API version from your Meta app dashboard.
WHATSAPP_GRAPH_VERSION=

# Hosted invitation pilot only. Generate keys with npm run keys.
PUBLIC_ORIGIN=
DB_PATH=
SELLER_ACCESS_KEY_HASH=
PILOT_ACCESS_KEY_HASH=
RIDER_ACCESS_KEYS_JSON=
# Optional Meta-approved template: body has exactly one text parameter.
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=

# Optional short voice notes through Sarvam (account credits required).
VOICE_ENABLED=false
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
